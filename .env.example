# Neon Postgres connection string (Dashboard -> Connect -> use the pooled connection string)
POSTGRES_URL=

# Optional: the non-pooled connection string, used by `pnpm db:seed` (see
# scripts/seed.js) since a multi-statement admin script is safer over a
# direct connection than through a pooler. Falls back to POSTGRES_URL if unset.
POSTGRES_URL_NON_POOLING=

# Used by NextAuth to sign session tokens. Generate one with: npx auth secret
AUTH_SECRET=
